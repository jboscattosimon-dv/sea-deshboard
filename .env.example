SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
SUPABASE_KEY=your_supabase_anon_key
JWT_SECRET=seu_segredo_jwt_aqui
PORT=3000

# E-mail (recuperação de senha) — via Resend (resend.com)
RESEND_API_KEY=
EMAIL_FROM=SEA Dashboard <onboarding@resend.dev>

# Trello (opcional — se não configurado, comentários não são postados)
TRELLO_API_KEY=
TRELLO_TOKEN=

# WhatsApp via Z-API (z-api.io) — cobrança automática de parcela atrasada.
# Se não configurado, o pagamento ainda é marcado como atrasado, só não
# manda a mensagem.
ZAPI_INSTANCE_ID=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=
